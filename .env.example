# scripts/run_demo.py works without an env file or external accounts.
SUPPORTFLOW_MODE=demo
SUPPORTFLOW_API_KEY=demo-local-key
SUPPORTFLOW_WEBHOOK_SECRET=demo-webhook-secret
SUPPORTFLOW_DB=runtime/supportflow.sqlite

# Optional paid AI drafting: explicitly configure these to enable it.
SUPPORTFLOW_DRAFTER=rules
OPENAI_API_KEY=
OPENAI_MODEL=

# For a real Shopify development store, change mode to live and configure
# strong SupportFlow secrets, read_orders credentials, and a helpdesk gateway.
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
HELPDESK_URL=
HELPDESK_API_KEY=
